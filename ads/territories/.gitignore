!/DEFAULT - SYNC - Crystal Tower x 3/
/DEFAULT - SYNC - Crystal Tower x 3/*
!/DEFAULT - SYNC - Crystal Tower x 3/*_rule_objects.json
!/DEFAULT - UNSYNC - Crystal Tower x 3/
/DEFAULT - UNSYNC - Crystal Tower x 3/*
!/DEFAULT - UNSYNC - Crystal Tower x 3/*_rule_objects.json
